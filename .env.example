# Mindcraft AI Companion — environment configuration
# Copy to .env and fill in your values.
# Lines starting with # are comments and are ignored.

# ---------------------------------------------------------------------------
# Launcher ports
# Used by node launcher.mjs / Mindcraft.bat / Mindcraft.sh / Mindcraft.command
# Set these here to avoid port conflicts with other software on your machine.
# ---------------------------------------------------------------------------

# Port the API server listens on. (default: 8080)
# API_PORT=8080

# Port the dashboard dev server listens on. (default: 3000, dev mode only)
# DASH_PORT=3000

# ---------------------------------------------------------------------------
# API server (direct invocation)
# The launcher sets PORT automatically from API_PORT above.
# Only change PORT if you are running the API server directly without the launcher.
# ---------------------------------------------------------------------------

# Port the API server binds to. Required when running directly.
PORT=8080

# Runtime environment. Use "production" for prod builds.
# NODE_ENV=production

# Log verbosity: trace | debug | info | warn | error  (default: info)
# LOG_LEVEL=info

# ---------------------------------------------------------------------------
# LLM Providers
# Set the key(s) for whichever provider(s) you want to use.
# At least one provider must be reachable or the bot falls back to keywords.
# ---------------------------------------------------------------------------

# OpenAI — https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Anthropic — https://console.anthropic.com/account/keys
# ANTHROPIC_API_KEY=sk-ant-...

# Ollama (local, no key needed). Change URL if Ollama runs on another host.
# OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# LLM behaviour
# ---------------------------------------------------------------------------

# Hard timeout per LLM request in milliseconds. (default: 30000)
# LLM_TIMEOUT_MS=30000

# Maximum LLM calls per bot per minute. Prevents runaway API spend. (default: 20)
# LLM_MAX_CALLS_PER_MINUTE=20

# ---------------------------------------------------------------------------
# Bot safety caps
# ---------------------------------------------------------------------------

# Maximum simultaneous bots this server will accept. (default: 10)
# MINDCRAFT_MAX_BOTS=10

# Maximum tasks in each bot's queue at once. (default: 10)
# MINDCRAFT_MAX_TASKS=10

# ---------------------------------------------------------------------------
# Persistence
# ---------------------------------------------------------------------------

# Directory where bot memory, habits, and waypoints are saved. (default: ~/.mindcraft)
# MINDCRAFT_DATA_DIR=~/.mindcraft

# Set to "false" to run entirely in memory — nothing written to disk. (default: true)
# MINDCRAFT_PERSISTENCE=true

# ---------------------------------------------------------------------------
# Debug mode
# ---------------------------------------------------------------------------

# Set to "true" for deterministic timers, suppressed idle behaviours, and
# verbose task-transition logs. Use when reproducing a bug or bisecting behaviour.
# (default: false)
# MINDCRAFT_DEBUG=false
